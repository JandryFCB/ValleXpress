# Caddy saca y renueva solo el certificado HTTPS (Let's Encrypt) de cada dominio y reenvía todo al backend,
# incluido el tiempo real (Socket.IO por WebSocket).
#   DOMINIO          el principal (vallexpress.com)
#   DOMINIO_ANTERIOR el que usan las apps ya instaladas (vallexpress.duckdns.org): debe seguir respondiendo igual
#                    hasta que todos tengan una versión de la app con el dominio nuevo
{$DOMINIO}, {$DOMINIO_ANTERIOR} {
	encode gzip
	reverse_proxy backend:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# www.vallexpress.com -> vallexpress.com
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
