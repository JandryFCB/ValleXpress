# ValleXpress · variables de PRODUCCIÓN. Copia este archivo como deploy/.env y llena los valores.
# NUNCA subas deploy/.env a git (ya está en .gitignore). Usa claves NUEVAS, distintas a las de desarrollo.

# Dominio público de la API (sin https://). Gratis: <tu-ip-con-guiones>.sslip.io o un subdominio de DuckDNS.
DOMINIO=api.tudominio.com
# El dominio anterior (las apps ya instaladas lo usan): Caddy responde también en él
DOMINIO_ANTERIOR=vallexpress.duckdns.org
PUBLIC_URL=https://api.tudominio.com

PORT=3000

# Base de datos (solo la ve el backend; no se expone a internet)
DB_NAME=vallexpress
DB_USER=vallexpress
DB_PASSWORD=CAMBIA_ESTO_por_una_clave_larga_y_aleatoria

# Firma de las sesiones: mínimo 32 caracteres (el servidor no arranca con una más corta). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=15m
REFRESH_DIAS=90

# Correo (Brevo): clave API NUEVA, remitente verificado y a dónde llegan las respuestas (soporte)
BREVO_API_KEY=
SMTP_FROM=
REPLY_TO_EMAIL=

# Respaldos diarios de la base: cuántos días se guardan
RESPALDOS_DIAS=14
