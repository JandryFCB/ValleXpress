<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono adaptable: Android recorta lo que queda fuera de la zona segura central (~66%), según la forma de cada
     marca (círculo, gota, cuadrado). Por eso el logo va con margen y el fondo es el mismo azul noche del logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
    <inset android:drawable="@drawable/ic_launcher_foreground" android:inset="20%"/>
  </foreground>
</adaptive-icon>
