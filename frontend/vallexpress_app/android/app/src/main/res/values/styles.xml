<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mientras el proceso arranca: fondo de la marca con el logo (nunca una pantalla negra o blanca) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Detrás de Flutter mientras se inicia: el mismo azul noche, para que no haya parpadeo -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_fondo</item>
    </style>
</resources>
