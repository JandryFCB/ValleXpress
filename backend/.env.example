# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

NODE_ENV=development
PORT=3000

# Base de datos (el mismo usuario/clave los usa docker-compose)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vallexpress_db
DB_USER=vallexpress_user
DB_PASSWORD=cambia_esta_clave

# JWT: genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Servicios externos
GOOGLE_MAPS_API_KEY=
BREVO_API_KEY=
SMTP_FROM=
REPLY_TO_EMAIL=

# Ruta al JSON de la cuenta de servicio de Firebase Admin (fuera del repo)
FIREBASE_SERVICE_ACCOUNT_PATH=

# URL pública del backend (para armar los enlaces de las imágenes). En local se deduce sola;
# en producción, detrás de Nginx, ponla: https://api.tudominio.com
PUBLIC_URL=

# Carpeta de imágenes subidas (por defecto backend/uploads) y expiración del JWT
UPLOADS_DIR=
JWT_EXPIRA=7d
