{
  "name": "vallexpress-backend",
  "version": "1.0.0",
  "description": "Backend para ValleXpress - Sistema de Delivery",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "test:auth": "node test/auth.e2e.js",
    "test:cuenta": "node test/cuenta.e2e.js",
    "test:catalogo": "node test/catalogo.e2e.js",
    "test:tienda": "node test/tienda.e2e.js",
    "test:pedidos": "node test/pedidos.e2e.js",
    "test": "npm run test:auth && npm run test:cuenta && npm run test:catalogo && npm run test:pedidos",
    "test:repartidores": "node test/repartidores.e2e.js",
    "test:identidad": "node test/identidad.e2e.js"
  },
  "keywords": [
    "delivery",
    "api",
    "express",
    "postgresql"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "engine.io": "^6.6.5",
    "engine.io-parser": "^5.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.6.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "sequelize": "^6.35.1",
    "sharp": "^0.35.5",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.4"
  }
}
